# Database Configuration
# NOTE: For local development, password is set in User Secrets
# This is only used for Docker deployment
SQL_PASSWORD=DevPassword123!@#

# IBKR API Configuration
IBKR_TOKEN=your_ibkr_token_here
IBKR_QUERY_ID=your_query_id_here
IBKR_TODAY_EXEC_ID=your_today_exec_id_here

# Market Data Service Selection
# Options: "yahoo" or "fmp" (Financial Modeling Prep)
# Default: fmp (if not specified)
MARKET_DATA_SERVICE=fmp

# Financial Modeling Prep API Configuration
# Required if MARKET_DATA_SERVICE=fmp
FMP_API_KEY=your_fmp_api_key_here

# Yahoo Finance API Configuration
# Optional: defaults to https://query1.finance.yahoo.com if not specified
# Alternative: https://query2.finance.yahoo.com
YAHOO_FINANCE_BASE_URL=https://query1.finance.yahoo.com
